# -------------------------------------------------------------------
# Aufgabentool – Umgebungsvariablen
#
# Diese Datei als .env.local kopieren und ausfüllen. .env.local gehört
# NICHT ins Repository (steht in .gitignore). In Vercel dieselben Werte
# unter Settings > Environment Variables hinterlegen.
# -------------------------------------------------------------------

# Schutz der internen Routen (/api/onoffice/*, /api/mail/*, /api/cron/*).
# Lange Zufallszeichenkette, z.B.: openssl rand -hex 32
INTERNAL_API_SECRET=

# --- onOffice API -------------------------------------------------
# Token und Secret stehen im Benutzerdatensatz des API-Benutzers in
# onOffice enterprise. Das Secret niemals weitergeben oder committen.
ONOFFICE_API_TOKEN=
ONOFFICE_API_SECRET=
# Standard ist die stabile Version; nur ändern, wenn nötig.
ONOFFICE_API_URL=https://api.onoffice.de/api/stable/api.php

# Identität für den Mailversand über onOffice (resourcetype sendmail).
# Das Postfach muss dem API-Benutzer zugeordnet sein:
# Extras > Einstellungen > Grundeinstellungen > E-Mail
ONOFFICE_EMAIL_IDENTITY=

# Dateityp, unter dem Anhänge in onOffice landen.
ONOFFICE_FILE_ART=Dokument

# Statusabbildung onOffice -> Aufgabentool. Die realen Zahlen des
# Mandanten meldet /api/onoffice/probe; danach hier festnageln.
# Beispiel: 1=Nicht begonnen, 2=In Bearbeitung, 3=Erledigt, 4=Zurückgestellt
ONOFFICE_STATUS_MAP=1=offen,2=in_bearbeitung,3=erledigt,4=offen
# Ab welchem Prio-Wert gilt eine Aufgabe als "Hoch"?
ONOFFICE_PRIO_HOCH_AB=4

# --- Mailversand -------------------------------------------------
# onoffice | smtp | log   (leer lassen = Einstellung aus der Datenbank)
MAIL_PROVIDER=

# SMTP-Postfach bei 4-wk.de. Port 465 = SSL, 587 = STARTTLS.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=Aufgabentool 4wändekanzlei <aufgaben@4-wk.de>

# --- Supabase (kommt im nächsten Schritt) ------------------------
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Nur serverseitig verwenden, nie im Browser:
SUPABASE_SERVICE_ROLE_KEY=
