# -------------------------------------------------------------------
# Aufgabentool – Umgebungsvariablen
#
# Lokal: diese Datei als .env.local kopieren und ausfuellen.
#        Eintragen bequem mit:  npm run zugangsdaten
#                               npm run zugangsdaten smtp
# Vercel: dieselben Werte unter Settings > Environment Variables.
# .env.local gehoert NICHT ins Repository (steht in .gitignore).
# -------------------------------------------------------------------

# === Minimum fuer den Betrieb ======================================

# Schutz der internen Routen (/api/onoffice/*, /api/mail/*).
# Lange Zufallszeichenkette:  openssl rand -hex 32
INTERNAL_API_SECRET=

# Token und Secret des API-Benutzers aus onOffice enterprise.
ONOFFICE_API_TOKEN=
ONOFFICE_API_SECRET=

# === onOffice, optional ============================================

ONOFFICE_API_URL=https://api.onoffice.de/api/stable/api.php

# Identitaet fuer den Mailversand ueber onOffice (resourcetype sendmail).
# Das Postfach muss dem API-Benutzer zugeordnet sein:
# Extras > Einstellungen > Grundeinstellungen > E-Mail
ONOFFICE_EMAIL_IDENTITY=

# Dateityp, unter dem Anhaenge in onOffice landen.
ONOFFICE_FILE_ART=Dokument

# Statuswerte beim SCHREIBEN nach onOffice. Beim Lesen erkennt der Code
# die Klartext-Beschriftungen automatisch ("In Bearbeitung", "Erledigt").
# Ob onOffice beim Schreiben Zahlen oder Beschriftungen erwartet, ist im
# Mandanten noch nicht geprueft - deshalb hier einstellbar.
ONOFFICE_STATUS_OFFEN=1
ONOFFICE_STATUS_IN_BEARBEITUNG=2
ONOFFICE_STATUS_ERLEDIGT=3

# Prio: in onOffice ist 1 die hoechste Stufe. Bis zu diesem Wert gilt
# eine Aufgabe bei uns als "Hoch". Im Mandanten kommen 1-4 vor.
ONOFFICE_PRIO_HOCH_BIS=1
ONOFFICE_PRIO_NORMAL=3

# === Mailversand ===================================================

# onoffice | smtp | log   (leer = Einstellung aus der Datenbank)
MAIL_PROVIDER=

# SMTP-Postfach bei 4-wk.de. Port 465 = SSL, 587 = STARTTLS.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=Aufgabentool 4waendekanzlei <aufgaben@4-wk.de>

# === Supabase (naechster Schritt) ==================================

NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Nur serverseitig verwenden, nie im Browser:
SUPABASE_SERVICE_ROLE_KEY=

# Basisadresse fuer Links in Mails (Einladung, Passwort). Ohne diese
# Variable raet der Server die Adresse aus dem Aufruf - auf Vercel geht
# das gut, lokal landet man auf localhost.
NEXT_PUBLIC_SITE_URL=https://task.4waendekanzlei.de
